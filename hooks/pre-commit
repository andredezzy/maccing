#!/usr/bin/env sh
# Git pre-commit hook: refuses a commit that stages vocabulary belonging to private work.
#
# Install it with `git config core.hooksPath hooks`, which points git at this tracked directory so
# the hook travels with the repository instead of living unversioned under `.git/hooks`. That one
# setting also installs `commit-msg` beside it, which is the half of the gate this hook cannot do:
# a pre-commit hook is never handed the message.
#
# `--staged` reads the content out of the index, not off disk, so what is checked is what the
# commit will actually contain. A file staged clean and then dirtied passes; a file staged dirty
# and then cleaned fails.
#
# The vocabulary is committed nowhere. CI reads it from the LEAK_PROTECTIONS_JSON secret; here
# it is an untracked, git-ignored file in the repository being guarded — `leak-protections.json`
# at the root, or `.maccing/leak-protections.json`, whichever exists. Set LEAK_PROTECTIONS to
# name a different one:
#
#   export LEAK_PROTECTIONS="$HOME/somewhere/else/leak-protections.json"
#
# Naming a default rather than demanding the export is what stops this hook refusing every
# `git commit` on a machine where nobody remembered to set it.
#
# --require-overlay is what makes the hook worth installing. Without it a checkout with no overlay
# would match nothing, exit 0, and let every commit through while looking exactly like a clean
# gate. With it, an unset LEAK_PROTECTIONS fails the commit and says what is missing. It refuses an
# overlay that loaded no terms too, so a truncated or emptied dictionary is not a silent pass.

set -eu

repository=$(git rev-parse --show-toplevel)
# Two conventional homes, first one found wins: the repository root, and `.maccing/` for a
# repository that already keeps its maccing-related files there. Neither is tracked. When
# neither exists nothing is set, the checker loads no vocabulary, and --require-overlay turns
# that into a refusal that says so rather than a pass over an unchecked tree.
if [ -z "${LEAK_PROTECTIONS:-}" ]; then
  for candidate in "$repository/leak-protections.json" "$repository/.maccing/leak-protections.json"; do
    if [ -f "$candidate" ]; then
      LEAK_PROTECTIONS=$candidate
      break
    fi
  done
fi
export LEAK_PROTECTIONS
exec bun "$repository/.github/scripts/leak-check.ts" --staged --require-overlay
