#!/usr/bin/env sh
# Git pre-commit hook: refuses a commit that stages vocabulary belonging to private work.
#
# Install it with `git config core.hooksPath hooks`, which points git at this tracked directory so
# the hook travels with the repository instead of living unversioned under `.git/hooks`.
#
# The vocabulary is not in this repository. Export LEAK_TERMS in your shell profile so every
# `git commit` inherits it:
#
#   export LEAK_TERMS="$HOME/path/to/private/leak-terms.json"
#
# --require-overlay is what makes the hook worth installing. Without it a checkout with no overlay
# would match nothing, exit 0, and let every commit through while looking exactly like a clean
# gate. With it, an unset LEAK_TERMS fails the commit and says what is missing.

set -eu

repository=$(git rev-parse --show-toplevel)
exec bun "$repository/scripts/leak-check.ts" --staged --require-overlay
