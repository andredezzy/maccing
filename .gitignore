.worktrees/

# Claude Code local artifacts — worktree storage (.claude/settings.json stays tracked) and the
# plugin-in-use marker the dev symlink writes into the repo when a plugin is installed from this path
.claude/worktrees/
**/.in_use/

# macOS
.DS_Store

# MCP secrets — `.env` files are committed templates; `.env.local` holds the real secrets (never commit)
**/.env.local

# Node — dev-only type deps for the MCP servers (@types/bun); the servers run with zero runtime deps
node_modules/

# Test coverage output (`bun test --coverage`)
**/coverage/

# Python
__pycache__/
*.pyc

# maccing-pictura legacy output (untracked tool output, never committed)
pictura-output/

# The leak-protection dictionary. Its content is the LEAK_PROTECTIONS github secret and it is never
# committed: the vocabulary lives in the secret and in this one untracked file, nowhere else.
# The sibling patterns matter as much as the first — an editor swap or backup beside it carries
# the same bytes under a name a single entry would miss.
/leak-protections.json*
/.leak-protections.json*
.maccing/leak-protections.json*
.maccing/.leak-protections.json*
