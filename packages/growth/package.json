    "url": "git+https://github.com/andredezzy/maccing.git",
    "directory": "packages/growth"
  },
  "bugs": {
    "url": "https://github.com/andredezzy/maccing/issues"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": "<0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./meta/whatsapp/campaigns/metrics": "./src/meta/whatsapp/campaigns/metrics.ts",
